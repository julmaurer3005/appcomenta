<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="32sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="InstaSorteio Auto"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automação no App Oficial do Instagram"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status de Permissão de Acessibilidade -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐 Permissões Necessárias"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Acessibilidade Desativada"
                    android:textColor="@color/danger_red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👉 ATIVAR ACESSIBILIDADE NAS CONFIGURAÇÕES"
                    android:backgroundTint="@color/accent_blue"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lista de Amigos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👥 Lista de Amigos (@)"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 amigos"
                        android:textColor="@color/accent_blue"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnImportFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📁 Importar Arquivo .txt"
                    android:backgroundTint="#1e293b"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etUserList"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#0b1120"
                    android:padding="10dp"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:gravity="top|start"
                    android:hint="@amigo1\n@amigo2\n@amigo3..."
                    android:textColorHint="#475569" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Configurações de Delays e Frases -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Configurações &amp; Variações"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Amigos por comentário -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Amigos por comentário:"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etChunkSize"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="3"
                        android:textAlignment="center"
                        android:textColor="@color/text_white"
                        android:background="#0b1120"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Delay Mínimo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Espera Mínima (segundos):"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etDelayMin"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="45"
                        android:textAlignment="center"
                        android:textColor="@color/text_white"
                        android:background="#0b1120"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Delay Máximo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Espera Máxima (segundos):"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etDelayMax"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="85"
                        android:textAlignment="center"
                        android:textColor="@color/text_white"
                        android:background="#0b1120"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Comentários por Lote -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pausa longa a cada (comentários):"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etBatchSize"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="5"
                        android:textAlignment="center"
                        android:textColor="@color/text_white"
                        android:background="#0b1120"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Duração da Pausa do Lote -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tempo da Pausa Longa (segundos):"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etBatchPause"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="300"
                        android:textAlignment="center"
                        android:textColor="@color/text_white"
                        android:background="#0b1120"
                        android:padding="6dp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbPhrases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adicionar frases curtas (Boa sorte, Sorteia eu...)"
                    android:textColor="@color/text_white"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbEmojis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adicionar emojis aleatórios (🍀, 🤞, ✨, 🔥...)"
                    android:textColor="@color/text_white"
                    android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão Iniciar Overlay Flutuante -->
        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 ABRIR MENU FLUTUANTE &amp; INSTAGRAM"
            android:padding="16dp"
            android:backgroundTint="@color/success_green"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
